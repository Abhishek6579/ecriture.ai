# Supabase project settings. Never place the service-role key in the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key
SUPABASE_SECRET_KEY=sb_secret_your-backend-secret

# Legacy key names may be used instead: SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.
# Required only for legacy Supabase projects using HS256 JWT signing.
# New asymmetric signing keys are verified against the project's JWKS endpoint.
# SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
REQUIRE_VERIFIED_EMAIL=true

# Free plan defaults: lifetime allowance, not a daily reset.
FREE_SCAN_LIMIT=5
# Optional global daily circuit breaker. Set 0 to disable.
GLOBAL_DAILY_SCAN_LIMIT=0

# Local Vite development origins. Add exact production frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_BYTES=15728640
